# MongoDB Replica Set URI (Atlas or local replica set required for multi-document ACID transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/banking

# Server Port (default 8080)
SERVER_PORT=8080

# Base64-encoded HMAC-SHA256 Secret (minimum 32 bytes / 256 bits)
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Set to true in production over HTTPS; false for local HTTP development
JWT_COOKIE_SECURE=false
